# Локальные ключи; .env не попадает в Git.
LLM_PROVIDER=sain
HACK_TEAM_TOKEN=
HACK_RUN_STAGE=final
HACK_VOICE_ENABLED=0
HACK_VOICE_ACCESS_KEY=
FRONTEND_ADMIN_KEY=
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Общий номер для финальной демонстрации.
ENABLE_LEGACY_DEMO=true
SESSION_CLEANUP_INTERVAL_SECONDS=60

# Для прокси организаторов выберите LLM_PROVIDER=sain и задайте LLM_API_KEY.
LLM_BASE_URL=https://bifrost.be-healthy.tech/v1
LLM_MODEL=gpt-6-luna
