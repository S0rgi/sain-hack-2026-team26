# Скопируйте в .env и выберите sain или google.
# Секреты передавайте через переменные окружения, .env не коммитится.
LLM_PROVIDER=sain
LLM_BASE_URL=https://bifrost.be-healthy.tech/v1
LLM_MODEL=gpt-6-luna

# Для Google задайте LLM_PROVIDER=google и GEMINI_API_KEY в окружении.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://gemini-proxy.ilyuxa-chernov-04.workers.dev
